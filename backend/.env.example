# Environment Variables Template for DevYatra Backend
# Copy this file to .env for development or .env.production for production
# Fill in your actual values - NEVER commit actual secrets to version control

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Twilio Configuration
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_SMS_FROM_NUMBER=your_twilio_phone_number
TWILIO_WHATSAPP_FROM_NUMBER=whatsapp:your_twilio_whatsapp_number
TWILIO_VOICE_FROM_NUMBER=your_twilio_phone_number
TWILIO_ALERT_CALL_TO=your_alert_phone_number
TWILIO_ALERT_SMS_TO=your_alert_phone_number
TWILIO_ALERT_WHATSAPP_TO=whatsapp:your_alert_phone_number

# API Keys
MAPQUEST_API_KEY=your_mapquest_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEOAPIFY_API_KEY=your_geoapify_api_key_here
WEATHER_API_KEY=your_weather_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
PINATA_JWT=your_pinata_jwt_token_here

# Security
SECRET_KEY=generate_a_secure_secret_key_here
DEBUG=true

# Database Configuration
DATABASE_URL=sqlite:///devyatra.db